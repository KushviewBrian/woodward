---
import type { Service } from '../data/services';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<a
  href={`/services/${service.slug}/`}
  class="group flex flex-col justify-between rounded border border-steel-300 bg-paper p-6 hover:border-signal hover:shadow-sm transition-all"
>
  <div>
    <h3 class="font-display text-xl text-ink-900 mb-2">{service.name}</h3>
    <p class="text-sm text-ink-500 leading-relaxed">{service.symptomSummary}</p>
  </div>
  <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-signal">
    See what to check
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">
      <path d="M5 12h14M13 5l7 7-7 7" />
    </svg>
  </span>
</a>
