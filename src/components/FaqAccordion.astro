---
import type { FaqItem } from '../data/faq';

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="divide-y divide-steel-300 border-y border-steel-300">
  {
    items.map((item) => (
      <details class="group py-4">
        <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-display text-lg text-ink-900">
          {item.question}
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            class="shrink-0 transition-transform group-open:rotate-45"
            aria-hidden="true"
          >
            <path d="M12 5v14M5 12h14" />
          </svg>
        </summary>
        <p class="mt-3 text-ink-500 leading-relaxed pr-8">{item.answer}</p>
      </details>
    ))
  }
</div>
