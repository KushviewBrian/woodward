---
import { business } from '../data/business';
import { withBase } from '../scripts/paths';

const mapsHref = `https://www.google.com/maps/search/?api=1&query=${business.mapsQuery}`;
---

<div
  id="sticky-mobile-bar"
  class="md:hidden fixed bottom-0 inset-x-0 z-50 grid grid-cols-3 bg-ink-900 text-paper border-t border-ink-700"
  data-open="true"
>
  <a href={business.phoneHref} class="flex flex-col items-center justify-center gap-1 py-2.5 min-h-12" aria-label={`Call Woodward Automotive at ${business.phoneDisplay}`}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
    </svg>
    <span class="text-xs font-medium">Call</span>
  </a>
  <a href={mapsHref} target="_blank" rel="noopener" class="flex flex-col items-center justify-center gap-1 py-2.5 min-h-12 border-x border-ink-700" aria-label="Get directions to 3909 Fourier Drive, Suite E">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
      <circle cx="12" cy="10" r="3" />
    </svg>
    <span class="text-xs font-medium">Directions</span>
  </a>
  <a href={withBase('/contact/')} id="sticky-request-link" class="flex flex-col items-center justify-center gap-1 py-2.5 min-h-12 bg-signal">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
    </svg>
    <span class="text-xs font-medium">Request</span>
  </a>
</div>

<script>
  import { getOpenStatus } from '../scripts/hours';

  const bar = document.getElementById('sticky-mobile-bar');
  if (bar) {
    const { isOpen } = getOpenStatus();
    if (!isOpen) {
      // When closed, lead with the form instead of a call nobody will answer.
      bar.style.direction = 'rtl';
      Array.from(bar.children).forEach((child) => {
        (child as HTMLElement).style.direction = 'ltr';
      });
    }
  }
</script>
