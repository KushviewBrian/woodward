---
import type { Review } from '../data/reviews';

interface Props {
  review: Review;
}

const { review } = Astro.props;
---

<figure class="rounded border border-steel-300 bg-paper-alt p-6 flex flex-col h-full">
  <blockquote class="text-ink-900 leading-relaxed grow">
    <p>&ldquo;{review.quote}&rdquo;</p>
  </blockquote>
  <figcaption class="mt-4 pt-4 border-t border-steel-300 flex items-center justify-between text-sm">
    <span class="font-semibold text-ink-700">{review.attribution}</span>
    <a href={review.profileUrl} target="_blank" rel="noopener" class="text-ink-500 hover:text-signal transition-colors">
      {review.source} &middot; {review.date}
    </a>
  </figcaption>
</figure>
