---
import { withBase } from '../scripts/paths';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    ...(item.href ? { item: new URL(withBase(item.href), Astro.site).toString() } : {}),
  })),
};
---

<nav aria-label="Breadcrumb" class="text-sm text-ink-500 mb-6">
  <ol class="flex flex-wrap items-center gap-1.5">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-1.5">
          {i > 0 && <span aria-hidden="true">/</span>}
          {item.href ? (
            <a href={withBase(item.href)} class="hover:text-signal transition-colors">
              {item.label}
            </a>
          ) : (
            <span aria-current="page" class="text-ink-700">{item.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
