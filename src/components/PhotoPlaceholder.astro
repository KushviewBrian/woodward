---
// Stands in for commissioned shop photography (spec explicitly rules out
// stock mechanic photos). Swap for a real <img> once the shoot delivers —
// see CONTENT-TODO.md.
interface Props {
  label: string;
  class?: string;
  aspect?: string;
}

const { label, class: className = '', aspect = 'aspect-[4/3]' } = Astro.props;
---

<div class:list={["relative overflow-hidden rounded bg-ink-700", aspect, className]}>
  <svg class="absolute inset-0 w-full h-full text-ink-500/40" viewBox="0 0 100 75" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <rect width="100" height="75" fill="#2b3743" />
    <circle cx="30" cy="50" r="14" fill="none" stroke="currentColor" stroke-width="1.5" />
    <path d="M0 70 L28 45 L45 58 L65 35 L100 62 V75 H0 Z" fill="currentColor" opacity="0.5" />
  </svg>
  <span class="absolute bottom-2 left-2 rounded bg-ink-900/80 px-2 py-1 text-[11px] font-medium text-steel-300">
    {label}
  </span>
</div>
