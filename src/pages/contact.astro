---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ServiceRequestForm from '../components/ServiceRequestForm.astro';
import MapBlock from '../components/MapBlock.astro';
import { business, fullAddress } from '../data/business';

const title = 'Contact | Woodward Automotive, Fort Wayne IN';
const description =
  '3909 Fourier Dr, Suite E, Fort Wayne. Mon–Fri 10–6. Call (260) 710-8995 or request service online.';
---

<Layout title={title} description={description}>
  <section class="mx-auto max-w-[1200px] px-6 py-12 md:py-16">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Contact' }]} />
    <h1 class="font-display text-3xl md:text-5xl text-ink-900 mb-10">Contact us</h1>

    <div class="grid gap-12 lg:grid-cols-[1fr_1.3fr]">
      <div>
        <div class="rounded border border-steel-300 p-6 mb-6">
          <h2 class="font-display text-xl text-ink-900 mb-4">Reach us directly</h2>
          <a href={business.phoneHref} class="flex items-center gap-3 font-semibold text-lg text-ink-900 hover:text-signal transition-colors mb-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            {business.phoneDisplay}
          </a>
          <p class="text-ink-700 leading-relaxed">{fullAddress}</p>
          <p class="text-ink-500 mt-1">{business.hoursDisplay}</p>
        </div>

        <MapBlock />

        <div class="rounded border border-steel-300 bg-paper-alt p-6 mt-6">
          <h2 class="font-display text-lg text-ink-900 mb-2">Need a tow?</h2>
          <p class="text-ink-500 text-sm leading-relaxed">
            <!-- CONFIRM: towing policy — in-house, referral, or not offered. -->
            [CONFIRM: towing guidance to be added once confirmed with the shop.]
          </p>
        </div>
      </div>

      <div class="rounded border border-steel-300 bg-paper-alt p-6 md:p-8">
        <h2 class="font-display text-xl text-ink-900 mb-2">Send a service request</h2>
        <p class="text-ink-500 text-sm mb-6">We'll follow up during business hours.</p>
        <ServiceRequestForm />
      </div>
    </div>
  </section>
</Layout>
