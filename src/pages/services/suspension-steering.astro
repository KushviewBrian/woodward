---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import ServiceRequestForm from '../../components/ServiceRequestForm.astro';
import ReviewsSection from '../../components/ReviewsSection.astro';
import { services } from '../../data/services';
import { withBase } from '../../scripts/paths';

const service = services.find((s) => s.slug === 'suspension-steering')!;

const title = 'Suspension & Steering Repair in Fort Wayne, IN | Woodward Automotive';
const description =
  'Rough ride, wandering steering, or uneven tire wear? We diagnose suspension and steering issues in Fort Wayne. Call (260) 710-8995.';
---

<Layout title={title} description={description}>
  <ServiceHero
    service={service}
    intro="Suspension and steering problems are easy to get used to — the ride just slowly gets worse. If something feels different than it used to, that's worth trusting."
  />

  <section class="mx-auto max-w-[1200px] px-6 py-12 md:py-16 grid gap-12 md:grid-cols-[1.4fr_1fr]">
    <div class="prose-body">
      <h2 class="font-display text-2xl text-ink-900 mb-4">Come see us if you notice</h2>
      <ul class="space-y-2.5 text-ink-700 mb-10">
        {service.symptoms.map((symptom) => (
          <li class="flex gap-2.5">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="shrink-0 mt-0.5 text-signal" aria-hidden="true">
              <path d="M20 6 9 17l-5-5" />
            </svg>
            <span>{symptom}</span>
          </li>
        ))}
      </ul>

      <h2 class="font-display text-2xl text-ink-900 mb-4">What we do</h2>
      <p class="text-ink-700 leading-relaxed mb-4">{service.whatWeDo}</p>
      <p class="text-ink-700 leading-relaxed mb-10">
        Suspension and steering issues also show up as tire wear, so if your tires are wearing
        unevenly, that's often where we start looking — the tires are usually a symptom, not the
        cause.
      </p>

      <div class="grid sm:grid-cols-2 gap-6 mb-10">
        <div class="rounded border border-steel-300 p-5">
          <h3 class="font-display text-lg text-ink-900 mb-2">What it costs</h3>
          <p class="text-ink-500 text-sm leading-relaxed">{service.costNote}</p>
        </div>
        <div class="rounded border border-steel-300 p-5">
          <h3 class="font-display text-lg text-ink-900 mb-2">How long it takes</h3>
          <p class="text-ink-500 text-sm leading-relaxed">{service.timeNote}</p>
        </div>
      </div>

      <h2 class="font-display text-2xl text-ink-900 mb-4">Related services</h2>
      <div class="flex flex-wrap gap-3">
        <a href={withBase('/services/brake-repair/')} class="text-signal font-semibold hover:underline">Brake repair</a>
        <span class="text-steel-300">&middot;</span>
        <a href={withBase('/services/engine-diagnostics/')} class="text-signal font-semibold hover:underline">Engine diagnostics</a>
      </div>
    </div>

    <div>
      <div class="rounded border border-steel-300 bg-paper-alt p-6 sticky top-6">
        <h2 class="font-display text-xl text-ink-900 mb-4">Get it checked out</h2>
        <ServiceRequestForm compact />
      </div>
    </div>
  </section>

  <section class="bg-paper-alt border-y border-steel-300">
    <div class="mx-auto max-w-[1200px] px-6 py-12 md:py-16">
      <h2 class="font-display text-2xl text-ink-900 mb-8">What Fort Wayne says</h2>
      <ReviewsSection limit={2} />
    </div>
  </section>
</Layout>
