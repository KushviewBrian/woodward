---
import Header from '../components/Header.astro';
import UtilityBar from '../components/UtilityBar.astro';
import Footer from '../components/Footer.astro';
import StickyMobileBar from '../components/StickyMobileBar.astro';
import Schema from '../components/Schema.astro';
import { withBase } from '../scripts/paths';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Woodward Automotive" />
    <meta name="twitter:card" content="summary" />

    <Schema />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <UtilityBar />
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <StickyMobileBar />
  </body>
</html>
